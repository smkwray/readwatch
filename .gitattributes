# The upstream tree is LF and gofmt treats CRLF as unformatted, so a plain
# Windows checkout made `gofmt -l` flag every Go file. Pin line endings in the
# working tree rather than relying on each clone's core.autocrlf.
* text=auto eol=lf

# Batch files keep CRLF: cmd.exe is the one consumer that still cares.
*.cmd text eol=crlf

*.png  binary
*.ico  binary
*.syso binary
*.exe  binary

# tools/make_resources.py writes this: a quarter of a megabyte of .long/.short
# data emitting the Win32 resource section. Left unmarked it is the largest file
# in the tree, so GitHub calls the project half Assembly and diffs of it are
# noise.
tools/readwatch_resources_amd64.s linguist-generated=true
